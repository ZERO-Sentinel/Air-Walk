local function CTIKC_fake_script() -- TextButton.LocalScript 

	local script = Instance.new('LocalScript', TextButton)
	local RunService = game:GetService("RunService")
	local Players = game:GetService("Players")
	local player = Players.LocalPlayer
	local UserInputService = game:GetService("UserInputService")

	local toggleButton = script.Parent
	local frame = toggleButton.Parent
	local upButton = frame:FindFirstChild("UpButton")
	local downButton = frame:FindFirstChild("DownButton")
	local unloadButton = toggleButton.Parent:FindFirstChild("UnloadButton")
	local screenGui = toggleButton.Parent.Parent

	local floating = false
	local floatPoint = -3.1
	local floatPart = nil
	local floatingFunc = nil
	local floatDied = nil
	local upHeld = false
	local downHeld = false

	local function randomString()
		local length = math.random(10,20)
		local array = {}
		for i = 1, length do
			array[i] = string.char(math.random(32, 126))
		end
		return table.concat(array)
	end

	local floatName = randomString()
	_G.SentinelAirWalkPartName = floatName

	local function getRoot(character)
		return character:FindFirstChild("HumanoidRootPart")
	end

	local function stopFloat()
		floating = false
		upHeld = false
		downHeld = false
		if floatingFunc then
			floatingFunc:Disconnect()
			floatingFunc = nil
		end
		if floatDied then
			floatDied:Disconnect()
			floatDied = nil
		end
		if floatPart then
			floatPart:Destroy()
			floatPart = nil
		end
		_G.SentinelAirWalkPartName = nil
	end

	local function startFloat()
		local character = player.Character
		if not character then
			return
		end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local root = getRoot(character)
		if not humanoid or not root then
			return
		end
		if floating then
			return
		end
		floating = true
		floatPoint = -3.1
		floatPart = Instance.new("Part")
		floatPart.Name = floatName
		floatPart.Parent = character
		floatPart.Transparency = 1
		floatPart.Size = Vector3.new(2, 0.2, 1.5)
		floatPart.Anchored = true
		floatDied = humanoid.Died:Connect(function()
			stopFloat()
			toggleButton.Text = "OFF"
		end)
		floatingFunc = RunService.PreAnimation:Connect(function()
			if not floating then
				return
			end
			if character.Parent
				and character:FindFirstChild(floatName)
				and getRoot(character) then
				floatPart.CFrame =
					getRoot(character).CFrame * CFrame.new(0, floatPoint, 0)
			else
				stopFloat()
				toggleButton.Text = "OFF"
			end
		end)
	end

	toggleButton.MouseButton1Click:Connect(function()
		if floating then
			stopFloat()
			toggleButton.Text = "OFF"
		else
			startFloat()
			if floating then
				toggleButton.Text = "ON"
			end
		end
	end)

	if upButton then
		upButton.MouseButton1Down:Connect(function()
			if not floating or upHeld then
				return
			end
			upHeld = true
			floatPoint += 1.5
		end)
	end

	if downButton then
		downButton.MouseButton1Down:Connect(function()
			if not floating or downHeld then
				return
			end
			downHeld = true
			floatPoint -= 0.5
		end)
	end

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			if upHeld then
				upHeld = false
				floatPoint -= 1.5
			end
			if downHeld then
				downHeld = false
				floatPoint += 0.5
			end
		end
		if input.UserInputType == Enum.UserInputType.Touch then
			if upHeld then
				upHeld = false
				floatPoint -= 1.5
			end
			if downHeld then
				downHeld = false
				floatPoint += 0.5
			end
		end
	end)

	if unloadButton then
		unloadButton.MouseButton1Click:Connect(function()
			stopFloat()
			if screenGui and screenGui.Parent then
				screenGui:Destroy()
			end
		end)
	end
end
coroutine.wrap(CTIKC_fake_script)()
